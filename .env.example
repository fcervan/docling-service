# ATENÇÃO: este arquivo é versionado. NUNCA coloque chaves reais aqui.
# Copie para .env (ignorado pelo Git) e preencha localmente/no seu ambiente.
# O serviço escuta na porta 8765.
# Após alterar este arquivo: docker compose up -d --force-recreate

# JSON {"nome-do-app": "<sha256-hex-da-api-key>"} ou "app:<hash>,app2:<hash>"
# Gere com: python scripts/gerar_api_key.py
DOCLING_API_KEYS=

DOCLING_MAX_UPLOAD_MB=50
DOCLING_CONVERT_TIMEOUT=300
DOCLING_RATE_LIMIT_PER_MINUTE=60
DOCLING_MAX_WORKERS=2
DOCLING_SCHEMA_VERSION=1
DOCLING_DOCS_ENABLED=1

# OCR: auto (converte sem OCR e repete em PDF escaneado), on ou off
DOCLING_OCR_MODE=auto
# Caracteres por página abaixo disso disparam o OCR no modo auto
DOCLING_OCR_MIN_CHARS_PAGE=20
# Descarta os modelos após N segundos sem conversão (0 desliga)
DOCLING_IDLE_UNLOAD_SECONDS=900
